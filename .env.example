# Copy this file to .env and fill in real values. Never commit .env.

# Zuora: mock server defaults below. Swap in your partner sandbox values when you have them.
ZUORA_BASE_URL=http://localhost:8040
ZUORA_CLIENT_ID=demo-client
ZUORA_CLIENT_SECRET=demo-secret

# Stripe: test-mode secret key from https://dashboard.stripe.com/test/apikeys (starts with sk_test_)
STRIPE_API_KEY=sk_test_replace_me

# Salesforce Developer Edition
SF_USERNAME=you@example.com
SF_PASSWORD=replace_me
SF_SECURITY_TOKEN=replace_me

# Month 2
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
